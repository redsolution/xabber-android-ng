<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal|top"
    android:background="@android:color/white">



    <!-- Subtitle with domain -->
    <TextView
        android:id="@+id/subtitle_checking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/grey_500"
        android:text="@string/checking_features"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textSize="20sp" />

    <!-- Steps container -->
    <LinearLayout
        android:id="@+id/steps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Step 1: Message archive -->
        <LinearLayout
            android:id="@+id/step_message_archive_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_message_archive_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_message_archive"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_message_archive_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_message_archive_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Step 2: Synchronization -->
        <LinearLayout
            android:id="@+id/step_sync_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_sync_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_sync"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_sync_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_sync_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Step 3: Push notifications -->
        <LinearLayout
            android:id="@+id/step_push_notifications_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_push_notifications_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_push_notifications"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_push_notifications_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_push_notifications_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Step 4: Message editing -->
        <LinearLayout
            android:id="@+id/step_message_editing_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_message_editing_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_message_editing"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_message_editing_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_message_editing_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Step 5: Device management -->
        <LinearLayout
            android:id="@+id/step_device_management_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_device_management_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_device_management"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_device_management_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_device_management_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <!-- Step 6: Publish-subscribe -->
        <LinearLayout
            android:id="@+id/step_pubsub_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_pubsub_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_pubsub"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_pubsub_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_pubsub_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Step 7: File upload -->
        <LinearLayout
            android:id="@+id/step_file_upload_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="18dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/step_file_upload_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/step_file_upload"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">

                <ProgressBar
                    android:id="@+id/step_file_upload_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/step_file_upload_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_green"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <!-- Gray separator line -->
        <View
            android:id="@+id/separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_300"
            android:layout_marginVertical="24dp"
            android:visibility="gone"/>

        <!-- Motivational text -->
        <TextView
            android:id="@+id/tv_motivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motivation_text"
            android:textColor="@color/green_600"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>

        <!-- Let's rock button -->
        <Button
            android:id="@+id/btn_lets_rock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="36dp"
            android:text="@string/lets_rock"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/blue_500"
            android:background="@drawable/rounded_button_blue"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>