<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_gravity="start"
    android:paddingEnd="50dp">

    <FrameLayout
        android:id="@+id/tail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignBottom="@id/message_container"
        android:layout_marginStart="4dp"
        android:scaleX="-1" />

    <FrameLayout
        android:id="@+id/balloon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignStart="@id/message_container"
        android:layout_alignTop="@id/message_container"
        android:layout_alignEnd="@id/message_container"
        android:layout_alignBottom="@id/message_container"
        android:scaleX="-1" />

    <LinearLayout
        android:id="@+id/message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="@dimen/message_margin"
        android:layout_marginStart="-6.5dp"
        android:layout_toEndOf="@id/tail"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_message_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#673AB7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Анна Белова"
            tools:visibility="visible" />

        <!-- Other content (message text, images, etc.) will be added programmatically -->
    </LinearLayout>
</RelativeLayout>
