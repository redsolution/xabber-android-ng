<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/left_column"
        >
        <ImageView
            android:id="@+id/image_privacy"
            style="@style/device_icon"
            android:backgroundTint="@color/grey_500"
            android:src="@drawable/devices_web"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <TextView
        android:id="@+id/device_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/device_ip"
        android:text="Device Name" />
    <TextView
        android:id="@+id/device_client"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="normal"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/device_model"
        app:layout_constraintBottom_toTopOf="@id/device_last_auth"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Device Name" />


    <TextView
        android:id="@+id/device_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toBottomOf="@id/device_model"
        app:layout_constraintEnd_toStartOf="@id/device_last_auth"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="device ip" />
    <TextView
        android:id="@+id/device_last_auth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/device_ip"
        app:layout_constraintTop_toBottomOf="@id/device_model"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="Last Auth: Unknown" />
    <LinearLayout
        android:id="@+id/left_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent"
        >

    </LinearLayout>

    <LinearLayout
        android:id="@+id/right_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>