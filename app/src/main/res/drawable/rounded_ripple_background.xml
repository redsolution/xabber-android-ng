<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/blue_grey_50"> <!-- Ripple color -->
    <!-- Background shape (rounded rectangle) -->
    <item>
        <shape android:shape="rectangle">
            <!-- Rounded corners -->
            <corners android:radius="40dp" /> <!-- Adjust radius as needed -->

            <!-- Solid background color -->
            <solid android:color="@color/white" /> <!-- Replace with your desired background color -->
        </shape>
    </item>
</ripple>